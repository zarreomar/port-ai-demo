# Kubernetes kubeconfig written by `main create kubernetes`
export KUBECONFIG=/home/ubuntu/Projects/port-ai-demo/kubeconfig-dot.yaml
export KUBECONFIG_DOT=/home/ubuntu/Projects/port-ai-demo/kubeconfig-dot.yaml

# Crossplane package registry settings
# Use `ghcr.io` for provider packages when xpkg->ghcr token flow is denied.
export XPKG_REGISTRY_PROVIDER=ghcr.io
# Optional override for DOT configs; keep default unless needed.
# export XPKG_REGISTRY_DOT=xpkg.upbound.io

# Upbound registry credentials (optional, but recommended)
export UPBOUND_ACCESS_ID=<upbound-access-id>
export UPBOUND_TOKEN=<upbound-token>

# GHCR credentials (required if GHCR token endpoint returns DENIED)
export GHCR_USERNAME=<github-username-or-service-account>
export GHCR_TOKEN=<github-token-with-read:packages>

# Optional DNS host alias overrides for Crossplane pod
# Use comma-separated IPv4 values that work in your environment.
# export GHCR_IO_IPS=140.82.114.34,140.82.112.33
# export PKG_CONTAINERS_GITHUB_IO_IPS=185.199.108.154,185.199.109.154

# Optional proxy settings (only if your environment requires a proxy)
# export HTTP_PROXY=http://<proxy-host>:<port>
# export HTTPS_PROXY=http://<proxy-host>:<port>
# export NO_PROXY=127.0.0.1,localhost,.svc,.cluster.local
